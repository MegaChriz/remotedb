<?php

/**
 * @file
 * Enables registration and authentication via remote database.
 */

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Session\AccountInterface;
use Drupal\remotedbuser\Hook\RemotedbuserEntityHooks;
use Drupal\remotedbuser\Hook\RemotedbuserFormHooks;
use Drupal\remotedbuser\Hook\RemotedbuserUserHooks;
use Drupal\remotedbuser\Hook\RemotedbuserViewsHooks;
use Drupal\user\UserInterface;

/**
 * Implements hook_hook_info().
 */
function remotedbuser_hook_info(): array {
  $hooks = [
    'remotedb_user_load',
    'remotedb_user_presave',
    'remotedb_user_insert',
    'remotedb_user_update',
  ];

  $return = [];
  foreach ($hooks as $hook) {
    $return[$hook] = [
      'group' => 'remotedb',
    ];
  }

  return $return;
}

/**
 * Checks if user may retrieve users from the remote database.
 *
 * @deprecated in remotedb:8.x-1.x and is removed from a future version.
 *   Use the remotedbuser.remote_user_access_checker service instead.
 *
 * @param \Drupal\Core\Session\AccountInterface|null $account
 *   (optional) The account to check access for.
 */
function remotedbuser_get_remote_user_access(?AccountInterface $account = NULL): bool {
  @trigger_error('remotedbuser_get_remote_user_access() is deprecated in remotedb:8.x-1.x and will be removed from a future version. Use the remotedbuser.remote_user_access_checker service instead.', E_USER_DEPRECATED);
  return \Drupal::service('remotedbuser.remote_user_access_checker')->hasAccess($account);
}

/**
 * Implements hook_user_presave().
 */
#[LegacyHook]
function remotedbuser_user_presave(UserInterface $account): void {
  \Drupal::service(RemotedbuserUserHooks::class)->userPresave($account);
}

/**
 * Implements hook_user_view().
 */
#[LegacyHook]
function remotedbuser_user_view(array &$build, UserInterface $account, EntityViewDisplayInterface $display): void {
  \Drupal::service(RemotedbuserUserHooks::class)->userView($build, $account, $display);
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
#[LegacyHook]
function remotedbuser_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type): void {
  \Drupal::service(RemotedbuserEntityHooks::class)->entityBaseFieldInfoAlter($fields, $entity_type);
}

/**
 * Implements hook_views_api().
 */
#[LegacyHook]
function remotedbuser_views_api(): array {
  return \Drupal::service(RemotedbuserViewsHooks::class)->viewsApi();
}

/**
 * Implements hook_views_data().
 */
#[LegacyHook]
function remotedbuser_views_data(): array {
  return \Drupal::service(RemotedbuserViewsHooks::class)->viewsData();
}

/**
 * Implements hook_form_FORM_ID_alter() for form user_register_form().
 */
#[LegacyHook]
function remotedbuser_form_user_register_form_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(RemotedbuserFormHooks::class)->formUserRegisterFormAlter($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for form user_form().
 */
#[LegacyHook]
function remotedbuser_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  \Drupal::service(RemotedbuserFormHooks::class)->formUserFormAlter($form, $form_state);
}
