<?php

/**
 * @file
 * Remote database Webhook module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\remotedb\Entity\RemotedbInterface;
use Drupal\remotedb_webhook\Hook\RemotedbWebhookAccessHooks;
use Drupal\remotedb_webhook\Hook\RemotedbWebhookEntityHooks;

/**
 * Implements hook_entity_type_build().
 */
#[LegacyHook]
function remotedb_webhook_entity_type_build(array &$entity_types): void {
  \Drupal::service(RemotedbWebhookEntityHooks::class)->entityTypeBuild($entity_types);
}

/**
 * Implements hook_ENTITY_TYPE_access() for 'remotedb'.
 */
#[LegacyHook]
function remotedb_webhook_remotedb_access(RemotedbInterface $remotedb, string $operation, AccountInterface $account): AccessResult {
  return \Drupal::service(RemotedbWebhookAccessHooks::class)->remotedbAccess($remotedb, $operation, $account);
}
