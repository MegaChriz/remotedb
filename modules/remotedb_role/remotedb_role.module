<?php

/**
 * @file
 * Assign and unassign roles based on subscriptions in remote database.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\remotedb_role\Hook\RemotedbRoleHooks;
use Drupal\remotedb_role\Hook\RemotedbRoleUserHooks;
use Drupal\user\UserInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function remotedb_role_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(RemotedbRoleHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_user_login().
 */
#[LegacyHook]
function remotedb_role_user_login(UserInterface $account): void {
  \Drupal::service(RemotedbRoleUserHooks::class)->userLogin($account);
}
